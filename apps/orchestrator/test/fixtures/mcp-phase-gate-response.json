{
  "structuredContent": {
    "contract_version": "1.0",
    "tool_name": "continue-implementation",
    "status": "pending_execution",
    "action": "execute_procedure",
    "tool_call_success": true,
    "execution_owner": "client_llm",
    "retry_same_tool": false,
    "next_action": "execute_returned_procedure",
    "quality_gate_policy_version": "devcycle-phase-quality/v2",
    "instructions": "## Shared Phase Quality Policy\n\nPolicy version: `devcycle-phase-quality/v2`.\nThis policy governs refinement, implementation, code review, phase acceptance,\nand feature completion. It takes precedence over generic checkpoint boilerplate\nabout running every command or skipping review for a numbered phase. It does not\ngrant additional execution authority or change the selected workflow mode.\n\n### One gate protocol for every phase\n\nEvery phase uses the same completion reducer. Publish the supplied phase.gates\nJSON exchange beside the phase document as <phase-document>.gates.json. The\nneedCodeReview and needTestCoverage booleans are independent: false/false,\nfalse/true, true/false and true/true are all valid. Predict them during refinement\nfrom actual deliverables and acceptance criteria, with pending results. Do not\nset outcomes to passed during refinement. Documentation, DTO and checkpoint names\nare examples of scope, never exceptions in the gate engine. A phase identity is\nan opaque binding reference; its number, letter or title never selects gates.\n\nPreserve criteria, configured checks, actual execution evidence, meaningful\nassertion mappings and review outcome. Keep FeatureDescription.md's test manifest\nlinked to these records. Build, lint and running existing tests are independent\nconfigured obligations even with both flags false. Developers may revise flags\nwith before/after values, implemented scope, reason and evidence references; they\nmust not disable gates to hide failures. Update task/phase projections together.\nHEPHA supplies a host observation ledger for execution evidence. Use original\nexecution references, not a shell command that only reads a report. The supplied\nschema governs machine exchanges; Markdown is the readable projection. In\ncoverage.criteria, checkIds reference executable checks only: keep review evidence\nin the independent review gate, never add CW-REVIEW as a required test execution.\nAudit\nrunId and timestamps remain optional. Do not invent evidence to satisfy a field.\n\nMissing tests, inadequate meaningful coverage, failing tests and review findings\nprevent phase acceptance but remain same-phase repair work. Continue the\nimplementation/test/review loop automatically within the agreed scope. Do not\nactivate the next phase until the flags and configured checks are satisfied.\nA session boundary is not a reason to abandon repair. When the same failure\npersists, reassess infrastructure, architectural assumptions and the attempted\nfixes. Report rewrites, timestamps and new invocation IDs are not progress.\nEscalate only when a concrete architectural/intent/authority impasse or repeated\nlack of a meaningful repair path needs user help. State the exact cause, attempted\nrepairs, evidence and decision or capability needed. Honor cancellation and\nexecution authority. Never ask for another Continue click merely for failed tests.\n",
    "phase_gate_exchange_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "HEPHA exchange envelope v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "const": "hepha-exchange/v1"
        },
        "kind": {
          "const": "phase.gates"
        },
        "payload": {
          "title": "Declared phase gates and evidence v1",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "phaseId": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "flags": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "needCodeReview": {
                  "type": "boolean",
                  "description": "Whether the implemented phase scope requires code review. Independent of test coverage and configured health checks."
                },
                "needTestCoverage": {
                  "type": "boolean",
                  "description": "Whether phase acceptance requires assessment of meaningful test coverage against behavior and acceptance criteria. This is not numeric coverage measurement: absent percentage thresholds or instrumentation never disable this flag. Set false only when that assessment is inapplicable to the implemented scope, with a scope reason. Preserve any existing acceptance mappings when reconciling legacy numeric coverage N/A."
                }
              },
              "required": [
                "needCodeReview",
                "needTestCoverage"
              ]
            },
            "criteria": {
              "type": "array",
              "maxItems": 10000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "id",
                  "description"
                ]
              }
            },
            "checks": {
              "type": "array",
              "maxItems": 10000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "gate": {
                    "enum": [
                      "tests",
                      "gherkin_e2e",
                      "build",
                      "lint"
                    ]
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "command": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "cwd": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "outcome": {
                    "enum": [
                      "pending",
                      "passed",
                      "failed",
                      "not_run"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "maxItems": 10000,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        "toolCallId": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        }
                      },
                      "required": [
                        "path"
                      ]
                    }
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "id",
                  "gate",
                  "required",
                  "command",
                  "cwd",
                  "outcome",
                  "evidence"
                ]
              }
            },
            "review": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "outcome": {
                  "enum": [
                    "pending",
                    "approved",
                    "changes_required",
                    "not_applicable"
                  ]
                },
                "reportPath": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "outcome"
              ]
            },
            "coverage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "outcome": {
                  "enum": [
                    "pending",
                    "sufficient",
                    "missing",
                    "not_applicable"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "criteria": {
                  "type": "array",
                  "maxItems": 10000,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "criterionId": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "checkIds": {
                        "type": "array",
                        "maxItems": 10000,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        }
                      },
                      "testPaths": {
                        "type": "array",
                        "maxItems": 10000,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        }
                      },
                      "assertions": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "criterionId",
                      "checkIds",
                      "testPaths",
                      "assertions"
                    ]
                  }
                }
              },
              "required": [
                "outcome",
                "criteria"
              ],
              "description": "The active acceptance-coverage assessment, not an instrumentation or percentage report. If needTestCoverage is false, outcome is not_applicable with a scope reason and criteria is empty. A populated assessment requires reconciliation with the flag; do not delete mappings merely to bypass coverage."
            },
            "revisions": {
              "type": "array",
              "maxItems": 10000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "before": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "needCodeReview": {
                        "type": "boolean"
                      },
                      "needTestCoverage": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "needCodeReview",
                      "needTestCoverage"
                    ]
                  },
                  "after": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "needCodeReview": {
                        "type": "boolean"
                      },
                      "needTestCoverage": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "needCodeReview",
                      "needTestCoverage"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "implementedScope": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "evidencePaths": {
                    "type": "array",
                    "maxItems": 10000,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  }
                },
                "required": [
                  "before",
                  "after",
                  "reason",
                  "implementedScope",
                  "evidencePaths"
                ]
              }
            }
          },
          "required": [
            "phaseId",
            "flags",
            "criteria",
            "checks",
            "review",
            "coverage"
          ]
        },
        "audit": {
          "description": "Optional non-authoritative metadata, normalized separately."
        }
      }
    }
  }
}
