{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["replacements"],
  "properties": {
    "replacements": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["document", "checkId", "before", "after", "reason"],
        "properties": {
          "document": {"type": "string", "minLength": 1, "maxLength": 1000},
          "checkId": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "maxLength": 120},
          "before": {"type": "string", "minLength": 1, "maxLength": 10000},
          "after": {"type": "string", "minLength": 1, "maxLength": 10000},
          "reason": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    }
  }
}
