{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "baselineId",
    "criteria",
    "improvements"
  ],
  "properties": {
    "baselineId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "criteria": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceId",
              "status",
              "contributions"
            ],
            "properties": {
              "sourceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "status": {
                "const": "satisfied"
              },
              "contributions": {
                "type": "array",
                "maxItems": 500,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "evidenceId",
                    "explanation"
                  ],
                  "properties": {
                    "kind": {
                      "const": "automated"
                    },
                    "evidenceId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "explanation": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    }
                  }
                },
                "minItems": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceId",
              "status",
              "contributions",
              "gap"
            ],
            "properties": {
              "sourceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "status": {
                "const": "unmet"
              },
              "contributions": {
                "type": "array",
                "maxItems": 500,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "evidenceId",
                    "explanation"
                  ],
                  "properties": {
                    "kind": {
                      "const": "automated"
                    },
                    "evidenceId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "explanation": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    }
                  }
                }
              },
              "gap": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "obligation",
                  "expected",
                  "observed",
                  "references",
                  "nextAction"
                ],
                "properties": {
                  "obligation": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "expected": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "observed": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "references": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    }
                  },
                  "nextAction": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceId",
              "status",
              "contributions",
              "evidenceNeed"
            ],
            "properties": {
              "sourceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "status": {
                "const": "evidence_pending"
              },
              "contributions": {
                "type": "array",
                "maxItems": 500,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "evidenceId",
                    "explanation"
                  ],
                  "properties": {
                    "kind": {
                      "const": "automated"
                    },
                    "evidenceId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "explanation": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    }
                  }
                }
              },
              "evidenceNeed": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reason",
                  "references",
                  "nextAction"
                ],
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "references": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    }
                  },
                  "nextAction": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "kind": {
                    "enum": [
                      "execution_missing",
                      "environment_blocked",
                      "evidence_missing",
                      "investigation_required"
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    },
    "improvements": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation",
          "rationale",
          "references"
        ],
        "properties": {
          "observation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "references": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        }
      }
    }
  }
}
