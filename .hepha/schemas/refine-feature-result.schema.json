{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Refine Feature Result V1",
  "oneOf": [
    {
      "type": "object",
      "required": ["outcome", "summary", "files"],
      "additionalProperties": false,
      "properties": {
        "outcome": { "const": "COMPLETED" },
        "summary": { "type": "string", "minLength": 1 },
        "files": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "allOf": [
            { "contains": { "const": "FeatureTasks.md" }, "minContains": 1, "maxContains": 1 },
            { "contains": { "const": "planning-analysis-report.md" }, "minContains": 1, "maxContains": 1 },
            { "contains": { "const": "PhaseExecutionContract.json" }, "minContains": 1, "maxContains": 1 },
            { "contains": { "const": "ArchitectureDebtTouchPlan.json" }, "minContains": 1, "maxContains": 1 },
            { "contains": { "type": "string", "pattern": "^Phases/phase-[0-9]+(?:-[^/]+)?\\.md$" }, "minContains": 1 }
          ],
          "items": {
            "type": "string",
            "pattern": "^(FeatureTasks\\.md|planning-analysis-report\\.md|PhaseExecutionContract\\.json|ArchitectureDebtTouchPlan\\.json|Phases/phase-[0-9]+(?:-[^/]+)?\\.md)$"
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["outcome", "reason", "questions"],
      "additionalProperties": false,
      "properties": {
        "outcome": { "const": "NEEDS_DEEP_DIVE" },
        "reason": { "type": "string", "minLength": 1 },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["topic", "prompt", "recommendedOptionLabel", "options"],
            "additionalProperties": false,
            "properties": {
              "topic": { "type": "string", "minLength": 1 },
              "prompt": { "type": "string", "minLength": 1 },
              "recommendedOptionLabel": { "type": "string", "minLength": 1 },
              "options": {
                "type": "array",
                "minItems": 3,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "required": ["label", "description"],
                  "additionalProperties": false,
                  "properties": {
                    "label": { "type": "string", "minLength": 1 },
                    "description": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
