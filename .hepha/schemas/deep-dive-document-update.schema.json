{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deep Dive Document Update",
  "type": "object",
  "required": ["content"],
  "additionalProperties": true,
  "properties": {
    "content": { "type": "string", "minLength": 1 },
    "unresolvedAssumptions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
