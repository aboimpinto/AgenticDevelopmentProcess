{
  "name": "agentic-development-process",
  "version": "0.1.0",
  "description": "HEPHA is a local-first, human-supervised agentic software development platform.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aboimpinto/AgenticDevelopmentProcess.git"
  },
  "homepage": "https://github.com/aboimpinto/AgenticDevelopmentProcess#readme",
  "bugs": {
    "url": "https://github.com/aboimpinto/AgenticDevelopmentProcess/issues"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "pnpm": ">=11"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs --poll",
    "dev:all": "node scripts/dev.mjs --poll",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "demo:create": "node scripts/create-supervised-demo.mjs",
    "release:audit": "node scripts/public-release-audit.mjs",
    "release:prepare": "node scripts/prepare-public-release.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:mcp-adapter": "pnpm --filter @hepha/orchestrator exec tsx ../../scripts/check-mcp-adapter-contract.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^10.0.5",
    "vitest": "^5.0.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
