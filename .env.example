# Local SQLite database owned by the orchestrator.
# Example:
# HEPHA_DATABASE_PATH=.hepha/hepha.sqlite
HEPHA_DATABASE_PATH=

# Optional local path used during migration from the old DevCycle MCP repository.
DEVCYCLE_SOURCE_PATH=

# Recipe authority for Design Feature, Refine Feature, Start Implementing,
# Continue Implementing, and Complete Feature. Native Hepha remains the safe default.
# Set to devcycle-mcp to run the proven MCP recipes in one selected Pi model session.
HEPHA_FEATURE_RECIPE_SOURCE=native-hepha
# Optional per-action overrides: native-hepha or devcycle-mcp.
HEPHA_DESIGN_FEATURE_RECIPE_SOURCE=
HEPHA_REFINE_FEATURE_RECIPE_SOURCE=
HEPHA_START_IMPLEMENTING_RECIPE_SOURCE=
HEPHA_CONTINUE_IMPLEMENTING_RECIPE_SOURCE=
HEPHA_COMPLETE_FEATURE_RECIPE_SOURCE=
# Optional path overrides for locally installed compatibility assets.
HEPHA_DEV_CYCLE_MCP_CONFIG_PATH=
HEPHA_MCP_ADAPTER_EXTENSION_PATH=

# Provider credentials and routing are configured through Models. They are not
# environment variables or workflow-definition defaults.

# Local Hepha orchestrator defaults.
HEPHA_ORCHESTRATOR_PORT=4317
HEPHA_PI_RUN_TIMEOUT_MS=180000
# Refine Feature stops after this interval without observable Pi/tool activity.
HEPHA_PI_REFINE_FEATURE_STALL_TIMEOUT_MS=900000
# Optional explicit wall-clock safety cap. Empty means no maximum runtime.
HEPHA_PI_REFINE_FEATURE_MAX_RUNTIME_MS=
# Implementation workers stop only after this interval without observable
# Pi/tool stdout or stderr. Productive activity resets the stall circuit.
HEPHA_PI_IMPLEMENTATION_STALL_TIMEOUT_MS=1800000
# Optional explicit wall-clock safety cap. Empty means no maximum runtime.
HEPHA_PI_IMPLEMENTATION_MAX_RUNTIME_MS=
# Optional local skill overrides loaded for implementation-profile Pi workers.
# Defaults point at pi-packages/ under this repository when present.
HEPHA_SERIALIZED_BUILD_COMMANDS_SKILL_PATH=
HEPHA_DEEP_DIVE_SKILL_PATH=
HEPHA_DESIGN_FEATURE_SKILL_PATH=
HEPHA_REFINE_FEATURE_SKILL_PATH=
HEPHA_START_FEATURE_SKILL_PATH=
HEPHA_CONTINUE_IMPLEMENTATION_SKILL_PATH=
HEPHA_COMPLETE_FEATURE_SKILL_PATH=
# Fail persisted running workflow metadata when no live Pi process is attached
# and no workflow console file has changed for this long.
HEPHA_STALE_WORKFLOW_RUN_TIMEOUT_MS=300000
# Comma-separated registered project IDs explicitly authorized for narrowly
# detected startup preparation such as PostgreSQL database creation/migration.
# Empty disables project startup preparation for every project.
HEPHA_PROJECT_STARTUP_ALLOWLIST=
HEPHA_AGENT_CWD=
HEPHA_PI_SESSION_DIR=
# Raw Pi session artifacts are retained briefly for workflow-console recovery.
HEPHA_PI_SESSION_RETENTION_HOURS=6
HEPHA_PI_SESSION_CLEANUP_INTERVAL_MINUTES=15
# Optional absolute Pi executable path. Hepha treats this as a preferred path and
# falls back to local Pi installs if the configured file no longer exists.
HEPHA_PI_COMMAND=
